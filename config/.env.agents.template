# ============================================================
#  NTPC Fetch-Agent Config Template
#  Copy this file to:  config/.env.agents
#  Then fill in real values — do NOT commit .env.agents to git.
# ============================================================

# ── Destination folders ──────────────────────────────────────
# PDF_DIR must match what scripts/indexer.py reads from (line 11).
# Relative to project root.
PDF_DIR=frontend/public/reports

# Non-PDF downloads (Excel, Word, CSV) land here.
DOWNLOADS_DIR=data/raw/downloads

# Hash-based dedup manifest — keep this file; it prevents re-downloading.
MANIFEST_PATH=data/raw/agent_manifest.json

# Per-run, per-agent log files land here: logs/agents/<agent>_<timestamp>.log
LOG_DIR=logs/agents

# ── Retry / timeout / browser mode ───────────────────────────
AGENT_TIMEOUT_SECONDS=180
AGENT_MAX_RETRIES=3
AGENT_RETRY_BACKOFF_SECONDS=5

# HTTP (httpx) per-file download timeout in seconds.
HTTP_TIMEOUT_SECONDS=60

# Max files each agent downloads per run (0 = unlimited).
# OS/TC exposes 430+ PDFs - raise/remove this to pull more of them.
AGENT_MAX_FILES=50

# Run Chromium headless (true) or with a visible window (false).
# The orchestrator --headed flag overrides this to false for a single run.
PLAYWRIGHT_HEADLESS=true

# ── Source 1: OS/TC Documents (ASP.NET, internal LAN) ────────
OS_TC_URL=http://10.0.8.241/OS-TCDocs/OS_TC_Main.aspx

# CSS selector matching download links in the document grid.
# Adjust if the page uses a custom extension or non-standard attributes.
OS_TC_DOC_LINK_SELECTOR=a[href$='.pdf'], a[href$='.doc'], a[href$='.docx'], a[href$='.xls'], a[href$='.xlsx'], a[href$='.csv']

# CSS selector for the "Next page" button (leave blank if single-page).
# Example for an ASP.NET pager:  a[title='Next Page']
OS_TC_NEXT_PAGE_SELECTOR=

# Safety limit on how many grid pages to scan.
OS_TC_MAX_PAGES=20

# ── Source 2: EDOP (internal LAN) ────────────────────────────
EDOP_URL=https://ccitapps.ntpc.co.in/edop

# Comma-separated sub-paths to also scan (relative to EDOP_URL).
# Example:  /documents,/circulars,/policies
EDOP_SUB_PATHS=

EDOP_DOC_LINK_SELECTOR=a[href$='.pdf'], a[href$='.doc'], a[href$='.docx'], a[href$='.xls'], a[href$='.xlsx'], a[href$='.csv']

# EDOP is a JavaScript app (DoPDigitizationNew) with NO downloadable files.
# Its data is served by a public (no-login) JSON API. The agent ingests it and
# emits PDF(s) into the reports folder so the indexer reads it.
#   full    = every DoP -> every clause -> detailed power rows (one PDF per DoP)
#   summary = just category names + clause counts (lightweight)
EDOP_FETCH_MODE=full

# ── Source 3: Employee Experience (internal LAN) ─────────────
EMPEXP_URL=http://ccitapps.ntpc.co.in/empexp

EMPEXP_SUB_PATHS=

EMPEXP_DOC_LINK_SELECTOR=a[href$='.pdf'], a[href$='.doc'], a[href$='.docx'], a[href$='.xls'], a[href$='.xlsx'], a[href$='.csv']

# ── Source 4: NTPC Annual Reports (public internet) ──────────
ANNUAL_REPORTS_URL=https://www.ntpc.co.in/investors/financial-performance/annual-reports

# Selector matching all PDF links on the annual-reports page.
ANNUAL_REPORTS_PDF_SELECTOR=a[href$='.pdf'], a[href*='.pdf']

# ── Source 5: Circular Repository (internal LAN, FILE download) ──
CIRCULAR_REPOSITORY_URL=https://ccitapps.ntpc.co.in/circularrepository
CIRCULAR_DOC_LINK_SELECTOR=a[href$='.pdf'], a[href*='.pdf'], a[href$='.doc'], a[href$='.docx'], a[href$='.xls'], a[href$='.xlsx'], a[href$='.csv']

# ── Source 6: NTPC Wiki (internal LAN, PAGE CRAWL - no files) ───
# Crawls /ntpcwiki/Articles/Details?slug=... and saves each article as .txt.
NTPC_WIKI_URL=https://ccitapps.ntpc.co.in/ntpcwiki
WIKI_MAX_DEPTH=2
WIKI_MAX_PAGES=50

# ── Source 7: Safety Portal (internal LAN, MIXED/files) ─────────
# Shallow same-domain crawl to collect PDFs from the landing + sub-sections.
SAFETY_URL=http://10.0.8.68/safety
SAFETY_MAX_DEPTH=1
SAFETY_MAX_PAGES=25

# ── Source 8: CSR List (internal staging, PAGINATED TABLE -> JSON) ─
CSR_LIST_URL=https://itstaging.ntpc.co.in/om/CSRlist/CSRLIST
CSR_MAX_PAGES=30

# ── Schedule (for reference — not read by orchestrator) ──────
# Pass this expression to scheduler_setup.py --cron "..."
# Default: 12 PM (noon) every day — matches the registered NTPC_FetchAgents job
SCHEDULE_CRON=0 12 * * *
